# Copy this file to .env only on your private machine/server. Never commit real keys.
PORT=4173
HOST=0.0.0.0
# Leave blank for local dev; set your canonical public origin for deployment.
PUBLIC_BASE_URL=

# Optional official Google Places API integration. Results are transient in the app;
# review Google's current Places policy, attribution and storage rules before enabling.
GOOGLE_PLACES_API_KEY=

# Optional server-side Gemini content generation. Never put this key in browser code.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Optional local server-side Hugging Face Inference Providers integration.
HF_TOKEN=
HF_MODEL=Qwen/Qwen3-4B-Instruct-2507:fastest
