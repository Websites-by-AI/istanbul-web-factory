{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "istanbul-web-factory",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-10-04",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/preview/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "istanbul-web-factory",
      // Local Wrangler uses this placeholder; replace with the real ID before remote migration/deploy.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "GEMINI_MODEL": "gemini-flash-latest",
    "HF_MODEL": "Qwen/Qwen3-4B-Instruct-2507:fastest",
    "ALLOWED_ORIGINS": ""
  },
  "observability": {
    "enabled": true
  }
}
