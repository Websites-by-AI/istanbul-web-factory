{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "istanbul-web-factory",
  "main": "worker/index.mjs",
  "account_id": "88b6e2481cef2473409fdf549c56a54d",
  "compatibility_date": "2026-10-04",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/preview/*"]
  },
  "kv_namespaces": [
    {
      "binding": "STORE",
      "id": "148cb4ef2fd546ae86763637ae407a01"
    }
  ],
  "vars": {
    "GEMINI_MODEL": "gemini-flash-latest",
    "HF_MODEL": "Qwen/Qwen3-4B-Instruct-2507:fastest",
    "ALLOWED_ORIGINS": "https://websites-by-ai.github.io",
    "PUBLIC_BASE_URL": "https://istanbul-web-factory.aykanet34.workers.dev"
  },
  "observability": {
    "enabled": true
  }
}
